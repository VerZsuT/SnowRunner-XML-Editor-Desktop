{
	"name": "snowrunner-xml-editor-desktop",
	"productName": "SnowRunnerXMLEditor",
	"version": "1.4.0",
	"description": "Allows you to visually edit the game's XML files.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/VerZsuT/SnowRunner-XML-Editor-Desktop.git"
	},
	"main": ".vite/build/index.js",
	"scripts": {
		"package": "electron-forge package --platform=win32 --arch=x64",
		"package-prod": "npm i && cross-env NODE_ENV=production electron-forge package --platform=win32 --arch=x64",
		"start": "cross-env NODE_ENV=development electron-forge start",
		"lint": "eslint \"src/**/*.{ts,tsx}\"",
		"lint:fix": "npm run lint -- --fix",
		"check": "tsc --project src/tsconfig.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [],
	"author": {
		"name": "VerZsuT",
		"email": "verzsut@gmail.com"
	},
	"license": "MIT",
	"config": {
		"forge": "./src/build-configs/forge.js"
	},
	"devDependencies": {
		"@electron-forge/cli": "^8.0.1",
		"@electron-forge/plugin-vite": "^8.0.1",
		"@eslint/js": "^10.0.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "^5.1.1",
		"cross-env": "^10.1.0",
		"electron": "^45.4.1",
		"eslint": "^10.15.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-unicorn": "^80.0.0",
		"jsdom": "^31.0.1",
		"sass": "^1.108.2",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vite-plugin-static-copy": "^4.1.1",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@ant-design/icons": "^6.3.4",
		"antd": "^6.7.1",
		"cheerio": "^1.2.0",
		"debounce": "^4.0.0",
		"emr-bridge": "^2.1.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tslib": "^2.9.1",
		"valtio": "^2.3.2",
		"xml-formatter": "^3.7.1",
		"zustand": "^5.1.0"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"es5-ext@0.10.64": true,
		"esbuild@0.28.2": true,
		"unrs-resolver@1.12.2": true,
		"core-js@3.51.0": true
	}
}
