{
	"name": "snowrunner-xml-editor-desktop",
	"productName": "SnowRunnerXMLEditor",
	"version": "2.0.0",
	"description": "Allows you to visually edit the game's XML files.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/VerZsuT/SnowRunner-XML-Editor-Desktop.git"
	},
	"scripts": {
		"dev": "vite",
		"build": "npm run typegen && npm run check && vite build",
		"postinstall": "npm rebuild typescript",
		"typegen": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --features typegen --bin typegen",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"lint": "oxlint src",
		"lint:fix": "oxlint src --fix",
		"check": "node ./node_modules/typescript/bin/tsc --project src/tsconfig.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [],
	"author": {
		"name": "VerZsuT",
		"email": "verzsut@gmail.com"
	},
	"license": "MIT",
	"devDependencies": {
		"@tauri-apps/cli": "^2.12.6",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/coverage-v8": "^5.1.1",
		"jsdom": "^31.0.1",
		"oxc-transform-react": "~0.156.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2008",
		"sass": "^1.108.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@ant-design/icons": "^6.3.4",
		"@tauri-apps/api": "^2.12.5",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"antd": "^6.7.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zustand": "^5.1.0"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"es5-ext@0.10.64": true,
		"esbuild@0.28.2": true,
		"unrs-resolver@1.12.2": true,
		"core-js@3.51.0": true
	}
}