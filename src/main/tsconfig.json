{
  "compilerOptions": {
    "target": "es2025",
    "moduleResolution": "bundler",
    "module": "esnext",
    "newLine": "LF",
    "strict": true,
    "rootDir": "..",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "isolatedModules": true,
    "paths": {
      "@modules/*": ["../modules/*"],
      "@renderer/*": ["../renderer/*"],
      "@utilities/*": ["../utilities/*"],
      "@bridge/*": ["../utilities/bridge/*"],
      "@localization/*": ["../utilities/localization/*"],
      "@localization": ["../utilities/localization/index"]
    }
  }
}
