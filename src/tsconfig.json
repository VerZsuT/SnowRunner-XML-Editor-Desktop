{
	"compilerOptions": {
		"target": "es2025",
		"moduleResolution": "Bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "esnext",
		"jsx": "react-jsx",
		"rootDir": ".",
		"outDir": "../dist",
		"newLine": "LF",
		"strict": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"isolatedModules": true,
		"paths": {
			"@renderer/*": ["./renderer/*"],
			"@utilities/*": ["./utilities/*"],
			"@localization/*": ["./utilities/localization/*"],
			"@localization": ["./utilities/localization/index"]
		}
	}
}
